# Copy to .env.local (Next.js convention). See README.md.

# Backend HTTP API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8081

# Socket.IO (must match backend namespace /ws)
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8081/ws

# Google One Tap / Sign-In — must be the same OAuth client as backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
